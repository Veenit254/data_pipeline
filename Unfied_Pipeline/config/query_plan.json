{
  "_comment": "Edit freely. collect.py runs phases in this order and skips queries already completed (tracked in data/metadata/collection_state.json). Add queries to fill gaps. disk: warn when data/ passes warn_data_gb (and every warn_step_gb after), stop when free space < min_free_gb.",
  "fetch_domains": [
    "nseindia.com",
    "sebi.gov.in",
    "bseindia.com",
    "ibbi.gov.in",
    "nclt.gov.in",
    "business-standard.com",
    "economictimes.indiatimes.com",
    "moneycontrol.com",
    "livemint.com",
    "thehindubusinessline.com",
    "financialexpress.com",
    "web.archive.org",
    "archive.org"
  ],
  "_comment_sources": "open_web: fetch search results from ANY website (not only fetch_domains), except deny_domains. fetch_domains are the known sources: their links are harvested from any page, and records from them rank higher. The agent may append productive new websites (data/metadata/domain_registry.json, new=true, rows>0) to fetch_domains. domain_limits: requests per collect run and pause (seconds) before each request; URLs over budget are deferred to later --harvest-only runs. NSE rate-limits hard, so it gets few requests and long pauses.",
  "open_web": true,
  "deny_domains": [
    "youtube.com",
    "facebook.com",
    "twitter.com",
    "x.com",
    "instagram.com",
    "linkedin.com",
    "reddit.com",
    "quora.com",
    "pinterest.com",
    "t.me",
    "telegram.me",
    "whatsapp.com",
    "play.google.com",
    "apps.apple.com",
    "steamcommunity.com",
    "tiktok.com"
  ],
  "domain_limits": {
    "nseindia.com": {
      "max_per_run": 12,
      "delay_s": [
        10,
        20
      ]
    },
    "bseindia.com": {
      "max_per_run": 20,
      "delay_s": [
        5,
        10
      ]
    },
    "sebi.gov.in": {
      "max_per_run": 20,
      "delay_s": [
        4,
        8
      ]
    },
    "default": {
      "max_per_run": 15,
      "delay_s": [
        2,
        5
      ]
    },
    "archive.org": {
      "max_per_run": 20,
      "delay_s": [
        3,
        6
      ]
    }
  },
  "fetch_limit_per_query": 8,
  "_comment_run_limits": "Caps per run (scripts/run_limits.py). mode: capped | unlimited | ask (asks on a terminal only; unattended runs use the caps). 0, null or \"all\" = no limit. collect.py flags override: --max-files, --max-companies, --max-docs-per-company, --unlimited.",
  "run_limits": {
    "mode": "capped",
    "max_files": 60,
    "max_companies": 25,
    "max_docs_per_company": 5
  },
  "_comment_focus": "Historical focus (scripts/historical.py): companies delisted this many years ago. Proof from official/archive records first, then supporting documents per company; official and archive sources rank ahead of news.",
  "focus": {
    "years_ago": [
      15,
      20
    ]
  },
  "harvest_limit_per_page": 20,
  "block_domain_after_failures": 3,
  "network_probe_hosts": ["1.1.1.1:443", "8.8.8.8:443", "9.9.9.9:443"],
  "disk": {
    "warn_data_gb": 5,
    "warn_step_gb": 5,
    "min_free_gb": 20
  },
  "search": {
    "_comment": "Search providers (scripts/web_search.py, scripts/search_providers/): used in 'providers' order, the next one only when the previous is used up (units benched, daily/monthly limit, no API key, down). SearXNG's units are its engines (enable them in searxng/settings.yml); each API is one unit. Failing or junk-returning units are benched cooldown_min[reason] minutes. API keys go in .env or ~/.config/nse-unified-pipeline/keys.env, never here.",
    "providers": [
      "searxng",
      "serper",
      "brave"
    ],
    "provider_settings": {
      "searxng": {
        "url": "http://localhost:8082",
        "engines": [
          "google cse",
          "brave",
          "duckduckgo",
          "startpage",
          "bing",
          "mojeek",
          "yahoo",
          "qwant",
          "dogpile",
          "presearch",
          "yep"
        ],
        "engines_per_query": 2
      },
      "serper": {
        "gl": "in",
        "hl": "en",
        "num": 10,
        "daily_limit": 50,
        "monthly_limit": null
      },
      "brave": {
        "country": "IN",
        "search_lang": "en",
        "count": 20,
        "daily_limit": 50,
        "monthly_limit": 1900
      }
    },
    "cooldown_min": {
      "too many requests": 60,
      "suspended": 60,
      "captcha": 360,
      "access denied": 720,
      "irrelevant": 360,
      "default": 120,
      "quota": 1440
    },
    "irrelevant_after": 3,
    "query_delay_s": [
      20,
      40
    ]
  },
