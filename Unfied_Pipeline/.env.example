# Copy to .env (git-ignored). Generate the secret with: openssl rand -hex 32
SEARXNG_SECRET=
# Host port for SearXNG; the scripts expect 8082.
SEARXNG_PORT=8082

# Optional search APIs, used when SearXNG's engines are benched (order: search.providers in
# config/query_plan.json). Leave empty to disable. You can keep these outside the repo instead, in
# ~/.config/nse-unified-pipeline/keys.env (same format) or a file named by NSE_KEYS_FILE.
SERPER_API_KEY=
BRAVE_API_KEY=

# LM Studio model for the agent (scripts/run_agent.sh); empty = qwen/qwen3.8-27b.
CLINE_MODEL=
